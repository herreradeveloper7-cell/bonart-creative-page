---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-container">
    <a class="footer-logo" href="#inicio" aria-label="BonArt — Inicio">
      <img
        src="/media/bonart-logo.png"
        alt="BonArt"
        width="3117"
        height="2380"
        loading="lazy"
      />
    </a>
    <div class="footer-contact">
      <p>Diseño para un mundo más creativo.</p>
      <p>Bogotá, Colombia.</p>
      <a
        href="/contacto"
        data-contact
        aria-label="Contactar con BonArt al +57 321 5663191"
      >
        +57 321 5663191
      </a>
    </div>
    <nav class="footer-nav" aria-label="Navegación rápida">
      <a href="#inicio">Inicio</a>
      <a href="#servicios">Servicios</a>
      <a href="#proyectos">Proyectos</a>
      <a href="#nosotros">Nosotros</a>
    </nav>
    <p class="footer-copyright">
      © {year}
      <br />
      BonArt Creative
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding: 46px 7%;
    background: var(--color-seashell);
    border-top: 0;
    color: #666773;
  }
  .footer-container {
    max-width: 1160px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 0.7fr 1.15fr 1.65fr 0.55fr;
    align-items: center;
    gap: 36px;
    font-size: 11px;
    line-height: 1.7;
  }
  .footer-logo {
    display: block;
    width: 84px;
  }
  .footer-logo img {
    display: block;
    width: 100%;
    height: auto;
  }
  .footer-contact p,
  .footer-copyright {
    margin: 0;
  }
  .footer-nav {
    display: flex;
    align-items: center;
    justify-content: space-evenly;
    flex-wrap: wrap;
    gap: 12px 22px;
    padding: 8px 24px;
    border-inline: 1px solid #07101f22;
  }
  a {
    text-decoration: none;
    color: inherit;
  }
  a:hover {
    color: var(--color-lipstick-red);
  }
  a:focus-visible {
    outline: 2px solid var(--color-lipstick-red);
    outline-offset: 5px;
    border-radius: 2px;
  }
  .footer-copyright {
    white-space: nowrap;
  }
  @media (max-width: 1000px) {
    .footer-container {
      gap: 24px;
      grid-template-columns: auto 1fr 1.4fr auto;
    }
    .footer-nav {
      padding-inline: 16px;
      gap: 10px 16px;
    }
  }
  @media (max-width: 760px) {
    .site-footer {
      padding: 36px 28px;
    }
    .footer-container {
      grid-template-columns: auto 1fr;
      gap: 26px;
      font-size: 12px;
    }
    .footer-nav {
      grid-column: 1 / -1;
      justify-content: flex-start;
      padding: 20px 0;
      border-inline: 0;
      border-block: 1px solid #07101f22;
      gap: 16px 24px;
    }
    .footer-copyright {
      grid-column: 1 / -1;
    }
  }
</style>
