---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CloudBackground from '../components/CloudBackground.astro';
import Projects from '../components/Projects.astro';
import ServicesStrip from '../components/ServicesStrip.astro';
import About from '../components/About.astro';
import CallToAction from '../components/CallToAction.astro';
import Footer from '../components/Footer.astro';
import Testimonials from '../components/Testimonials.astro';
import BonifacioContact from '../components/BonifacioContact.astro';
---

<Layout>
  <Header />
  <main id="contenido">
    <div class="landing" id="inicio">
      <CloudBackground />
      <Hero />
    </div>
    <ServicesStrip />
    <Projects />
    <About />
    <CallToAction />
    <Testimonials />
  </main>
  <Footer />
  <BonifacioContact />
</Layout>
