---
import '../styles/fonts.css';
import '../styles/global.css';

const title = 'BonArt Creative | Branding y diseño web';
const description =
  'Estudio creativo en especializado en branding, diseño web y desarrollo de sistemas y tiendas online. Cuéntanos tu proyecto en BonArt Creative.';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <meta
      name="description"
      content="BonArt Creative: diseño, estrategia y desarrollo digital para crear marcas con personalidad, sitios web y experiencias que conectan."
    />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="preload"
      href="/fonts/poppins/poppins-latin-700-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="BonArt Creative" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <slot />
  </body>
</html>
