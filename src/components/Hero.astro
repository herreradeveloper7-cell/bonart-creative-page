---
import { ArrowDown, ArrowRight } from '@lucide/astro';
import '../styles/hero-reveal.css';
---

<script is:inline>
  // Runs before the text is painted; without JS the complete HTML stays visible.
  if (
    !matchMedia('(prefers-reduced-motion: reduce)').matches &&
    'requestVideoFrameCallback' in HTMLVideoElement.prototype &&
    CSS.supports('clip-path', 'polygon(0 0, 0 100%, 100% 100%)')
  ) {
    document.documentElement.dataset.bonifacio = 'pending';
    // Only a failure deadline, never an animation clock.
    setTimeout(() => {
      if (document.documentElement.dataset.bonifacio === 'pending') {
        document.documentElement.dataset.bonifacio = 'skipped';
      }
    }, 3500);
  }
</script>

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-content">
    <div class="hero-copy-stage">
      <div class="hero-copy">
        <p class="hero-eyebrow">Estrategia · Diseño · Desarrollo</p>
        <h1 id="hero-title">
          Marcas <span>vivas,</span>
          <br />
          ideas <span>reales</span>
        </h1>
      </div>
      <div class="bonifacio-layer" aria-hidden="true">
        <video
          class="bonifacio-video"
          muted
          playsinline
          preload="none"
          tabindex="-1"
          disablepictureinpicture
        >
          <source data-src="/media/bonifacio-reveal.webm" type="video/webm" />
        </video>
      </div>
    </div>
    <div class="hero-actions animate-bounce-fade-in">
      <a class="button button-primary" href="#proyectos">
        Ver proyectos{' '}
        <ArrowRight size={24} aria-hidden="true" style="flex-shrink: 0" />
      </a>
      <a
        class="button button-outline"
        href="https://wa.me/573215663191"
        target="_blank"
        rel="noopener noreferrer"
      >
        Cuéntanos tu idea
      </a>
    </div>
  </div>
  <a
    class="next-section"
    href="#servicios"
    aria-label="Bajar a la sección de servicios"
  >
    <span class="next-section-icon">
      <ArrowDown size={24} aria-hidden="true" />
    </span>
  </a>
</section>

<style>
  .hero {
    position: relative;
  }
  .next-section {
    position: absolute;
    left: calc(50% - 22px);
    bottom: 24px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: 0;
    border: 1px solid #fa609680;
    border-radius: 50%;
    background: #fdf5f280;
    color: var(--color-lipstick-red);
    transition:
      background-color 180ms,
      color 180ms;
    animation: hero-bounce-fade-in 500ms ease-out 1000ms backwards;
  }
  .next-section:hover {
    background: var(--color-lipstick-red);
    color: white;
  }
  .next-section-icon {
    display: flex;
    animation: arrow-nudge 2600ms ease-in-out 1500ms infinite;
  }
  @keyframes arrow-nudge {
    0%,
    55%,
    100% {
      transform: translateY(0);
    }
    68% {
      transform: translateY(4px);
    }
    80% {
      transform: translateY(0);
    }
    90% {
      transform: translateY(2px);
    }
  }
  .next-section:focus-visible {
    animation: none;
  }
  .next-section:hover .next-section-icon,
  .next-section:focus-visible .next-section-icon {
    animation-play-state: paused;
  }
  .animate-bounce-fade-in {
    animation: hero-bounce-fade-in 3000ms ease-in-out backwards;
  }

  @keyframes hero-bounce-fade-in {
    0% {
      opacity: 0;
      transform: translateY(12px) scale(0.97);
    }
    65% {
      opacity: 0.9;
      transform: translateY(-2px) scale(1.01);
    }
    84% {
      opacity: 1;
      transform: translateY(1px) scale(0.998);
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }

  .hero-actions:focus-within {
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-bounce-fade-in,
    .next-section,
    .next-section-icon {
      animation: none;
    }
  }
</style>

<script>
  import { initHeroReveal } from '../scripts/hero-reveal';
  initHeroReveal();
</script>
