---
import { Lightbulb, Users } from '@lucide/astro';
---

<section class="about-section" id="nosotros" aria-labelledby="about-title">
  <div class="about-container">
    <div class="about-heading">
      <h2 id="about-title">
        Ideas con <span class="about-soul">alma.</span>
        <br />
        Diseño con <span class="about-purpose">propósito.</span>
      </h2>
      <svg
        class="about-crayon"
        viewBox="0 0 300 48"
        fill="none"
        style="color: var(--color-rose-kiss);"
        aria-hidden="true"
      >
        <path
          d="M12 34 Q65 14 133 12 C151 11 102 42 111 41 Q197 18 288 14"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </div>
    <div class="about-copy">
      <p>
        Somos BonArt Creative, un estudio de diseño y desarrollo digital.
        Combinamos creatividad, estrategia y tecnología para dar vida a marcas
        auténticas y experiencias que conectan.
      </p>
      <ul class="about-values" aria-label="Nuestros valores">
        <li>
          <Lightbulb size={38} stroke-width={1.8} aria-hidden="true" />
          <span>Creatividad</span>
        </li>
        <li>
          <Users size={38} stroke-width={1.8} aria-hidden="true" />
          <span>Cercanía</span>
        </li>
        <li>
          <svg
            width="38"
            height="38"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20.7 9.7a9 9 0 1 1-6.4-6.4M16.7 10a5 5 0 1 1-2.7-2.7" />
            <path d="m12 12 7-7m0-3v3h3M12 11a1 1 0 1 0 1 1" />
          </svg>
          <span>Propósito</span>
        </li>
      </ul>
    </div>
  </div>
</section>
<script>
  const section = document.querySelector<HTMLElement>('.about-section');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  if (section && !reduced.matches && 'IntersectionObserver' in window) {
    const title = section.querySelector<HTMLElement>('#about-title')!;
    const paragraph = section.querySelector<HTMLElement>('.about-copy > p')!;
    const values = [
      ...section.querySelectorAll<HTMLElement>('.about-values li'),
    ];
    const paths = [
      ...section.querySelectorAll<SVGPathElement>('.about-crayon path'),
    ];
    const elements = [title, paragraph, ...values];
    const animations: Animation[] = [];
    let finished = false;
    elements.forEach((element) => (element.style.opacity = '0'));
    paths.forEach((path) => {
      const length = path.getTotalLength();
      path.style.strokeDasharray = `${length}`;
      path.style.strokeDashoffset = `${length}`;
    });
    const showAll = () => {
      finished = true;
      observer.disconnect();
      animations.forEach((animation) => animation.cancel());
      elements.forEach((element) => element.style.removeProperty('opacity'));
      paths.forEach((path) => {
        path.style.removeProperty('stroke-dasharray');
        path.style.removeProperty('stroke-dashoffset');
      });
      reduced.removeEventListener('change', showAll);
    };
    const animate = async (
      element: Element,
      frames: Keyframe[],
      options: KeyframeAnimationOptions,
    ) => {
      const animation = element.animate(frames, { ...options, fill: 'both' });
      animations.push(animation);
      await animation.finished;
      if (element instanceof HTMLElement)
        element.style.removeProperty('opacity');
      if (element instanceof SVGElement) element.style.strokeDashoffset = '0';
      animation.cancel();
    };
    const enter = async () => {
      observer.disconnect();
      const timing = { duration: 1100, easing: 'cubic-bezier(.22, 1, .36, 1)' };
      try {
        await Promise.all([
          (async () => {
            await animate(
              title,
              [
                { opacity: 0, transform: 'translateX(36px)' },
                { opacity: 1, transform: 'translateX(0)' },
              ],
              timing,
            );
            if (finished) return;
            await Promise.all(
              paths.map((path) =>
                animate(
                  path,
                  [
                    { strokeDashoffset: path.style.strokeDashoffset },
                    { strokeDashoffset: '0' },
                  ],
                  { duration: 1200, easing: 'ease-in-out' },
                ),
              ),
            );
          })(),
          (async () => {
            await animate(
              paragraph,
              [
                { opacity: 0, transform: 'translateX(-36px)' },
                { opacity: 1, transform: 'translateX(0)' },
              ],
              timing,
            );
            if (finished) return;
            await Promise.all(
              values.map((value, index) =>
                animate(
                  value,
                  [
                    {
                      opacity: 0,
                      transform: 'translateX(-24px) rotate(-35deg)',
                    },
                    { opacity: 1, transform: 'translateX(0) rotate(0)' },
                  ],
                  {
                    duration: 800,
                    delay: index * 180,
                    easing: 'cubic-bezier(.22, 1, .36, 1)',
                  },
                ),
              ),
            );
          })(),
        ]);
      } finally {
        showAll();
      }
    };
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting))
          void enter().catch(showAll);
      },
      { threshold: 0.2 },
    );
    observer.observe(section);
    reduced.addEventListener('change', showAll);
  }
</script>
<style>
  .about-section {
    padding: clamp(64px, 7vw, 100px) 7%;
    scroll-margin-top: 110px;
  }
  .about-container {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
    max-width: 1160px;
    margin-inline: auto;
  }
  .about-heading {
    width: fit-content;
    max-width: 100%;
  }
  .about-eyebrow {
    margin: 0 0 22px;
    color: var(--color-rose-kiss);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .about-heading h2 {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(32px, 3.55vw, 51px);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.055em;
  }
  .about-soul {
    color: var(--color-rose-kiss);
  }
  .about-purpose {
    color: var(--color-lipstick-red);
  }
  .about-crayon {
    display: block;
    width: 55%;
    max-width: 320px;
    height: auto;
    margin: 12px auto 0;
    color: var(--color-rose-kiss);
  }
  .about-copy {
    position: relative;
    padding-top: 0;
  }
  .about-copy::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(clamp(32px, 5vw, 72px) / -2);
    width: 1px;
    background: #07101f20;
    pointer-events: none;
  }
  .about-copy > p {
    margin: 0;
    color: #777983;
    font-size: clamp(15px, 1.25vw, 18px);
    line-height: 1.55;
  }
  .about-values {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: 12px;
    width: 100%;
    max-width: 360px;
    list-style: none;
    margin: 48px 0 0;
    padding: 0;
  }
  .about-values li {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    text-align: center;
    color: #07101f;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
  }
  .about-values :global(svg) {
    display: block;
    flex: none;
    width: 38px;
    height: 38px;
    color: var(--color-rose-kiss);
  }
  .about-values li:nth-child(2) :global(svg) {
    color: var(--color-muted-teal);
  }
  .about-values li {
    transform-origin: center 70%;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .about-values li:hover {
      animation: animate-rotational-wave 1100ms ease-in-out;
    }
  }
  @keyframes animate-rotational-wave {
    0%,
    100% {
      transform: translateY(0) rotate(0);
    }
    20% {
      transform: translateY(-4px) rotate(-7deg);
    }
    40% {
      transform: translateY(-2px) rotate(6deg);
    }
    60% {
      transform: translateY(-3px) rotate(-4deg);
    }
    80% {
      transform: translateY(-1px) rotate(2deg);
    }
  }
  @media (max-width: 760px) {
    .about-section {
      padding: 56px 28px;
    }
    .about-container {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .about-heading h2 {
      font-size: clamp(30px, 6.8vw, 46px);
    }
    .about-copy {
      padding-top: 0;
    }
    .about-copy::before {
      display: none;
    }
    .about-values {
      margin-top: 30px;
      gap: 10px;
    }
    .about-values li {
      font-size: clamp(12px, 3.5vw, 14px);
    }
  }
</style>
