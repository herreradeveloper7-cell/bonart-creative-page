---
import { CodeXml, Image, PanelsTopLeft, Sprout } from '@lucide/astro';

const services = [
  {
    title: 'Branding',
    description: 'Identidad visual para tu marca.',
    icon: Sprout,
  },
  {
    title: 'Diseño web',
    description: 'Sitios web y tiendas online.',
    icon: PanelsTopLeft,
  },
  {
    title: 'Desarrollo',
    description: 'Sistemas y aplicaciones web.',
    icon: CodeXml,
  },
  {
    title: 'Contenido',
    description: 'Contenido visual para tu marca.',
    icon: Image,
  },
];
---

<script is:inline>
  if (
    !matchMedia('(prefers-reduced-motion: reduce)').matches &&
    'IntersectionObserver' in window
  ) {
    document.documentElement.dataset.servicesReveal = 'pending';
  }
</script>

<section class="services-strip" id="servicios" aria-label="Servicios de BonArt">
  <div class="services-list">
    {services.map(({ title, description, icon: Icon }, index) => (
      <article
        class="service-item animate-pulse-fade-in"
        style={`--service-order: ${index}`}
      >
        <span class="service-icon" aria-hidden="true">
          <Icon size={27} stroke-width={1.8} />
        </span>
        <div>
          <h2>{title}</h2>
          <p>{description}</p>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .services-strip {
    position: relative;
    z-index: 2;
    background: #fffaf8;
    border-block: 1px solid #f4dfdf;
    padding: 24px 5%;
  }
  .services-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    max-width: 1280px;
    margin-inline: auto;
  }
  .service-item {
    display: flex;
    align-items: center;
    gap: 18px;
    min-width: 0;
    padding: 0 clamp(18px, 2.5vw, 38px);
    border-right: 1px solid #eaded9;
  }
  html[data-services-reveal='pending'] .animate-pulse-fade-in {
    opacity: 0;
    transform: translateY(12px) scale(0.92);
  }
  html[data-services-reveal='visible'] .animate-pulse-fade-in {
    animation: service-pulse-fade-in 950ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--service-order) * 180ms);
  }
  @keyframes service-pulse-fade-in {
    0% {
      opacity: 0;
      transform: translateY(12px) scale(0.92);
    }
    62% {
      opacity: 1;
      transform: translateY(-2px) scale(1.035);
    }
    82% {
      transform: translateY(1px) scale(0.992);
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }
  .service-item:first-child {
    padding-left: 0;
  }
  .service-item:last-child {
    padding-right: 0;
    border-right: 0;
  }
  .service-icon {
    display: grid;
    place-items: center;
    flex: 0 0 58px;
    width: 58px;
    height: 58px;
    border-radius: 46% 54% 58% 42% / 52% 43% 57% 48%;
    background: var(--color-rose-kiss);
    color: #07101f;
    transform: rotate(-5deg);
  }
  .service-icon :global(svg) {
    transform: rotate(5deg);
  }
  .service-item:nth-child(2) .service-icon {
    background: #f58ab0;
    transform: rotate(5deg);
  }
  .service-item:nth-child(3) .service-icon {
    background: var(--color-muted-teal);
    transform: rotate(-3deg);
  }
  .service-item:nth-child(4) .service-icon {
    background: #f58ab0;
    transform: rotate(4deg);
  }
  .service-item h2 {
    margin: 0 0 3px;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.25;
  }
  .service-item p {
    margin: 0;
    color: #786d69;
    font-size: 11px;
    line-height: 1.35;
  }
  @media (max-width: 900px) {
    .services-list {
      grid-template-columns: repeat(2, 1fr);
      gap: 26px 0;
    }
    .service-item:nth-child(2) {
      border-right: 0;
    }
    .service-item:nth-child(3) {
      padding-left: 0;
    }
  }
  @media (max-width: 520px) {
    .services-strip {
      padding: 28px 24px;
    }
    .services-list {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .service-item,
    .service-item:first-child,
    .service-item:last-child {
      padding: 16px 0;
      border-right: 0;
      border-bottom: 1px solid #eaded9;
    }
    .service-item:last-child {
      border-bottom: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .animate-pulse-fade-in {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('.services-strip');
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

  if (
    section &&
    document.documentElement.dataset.servicesReveal === 'pending'
  ) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          document.documentElement.dataset.servicesReveal = 'visible';
          observer.disconnect();
        }
      },
      { threshold: 0.25, rootMargin: '0px 0px -10% 0px' },
    );

    observer.observe(section);
    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches) {
        delete document.documentElement.dataset.servicesReveal;
        observer.disconnect();
      }
    });
  }
</script>
